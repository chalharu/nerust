<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only fault-injecting stub DocumentsProvider for the emulator
        abnormal-path tests (SafAbnormalProviderTest). Same APK/UID as the
        consumer, so no cross-package grant is needed; never shipped in
        release builds. The platform mandates MANAGE_DOCUMENTS protection
        for installed DocumentsProviders; the stub serves reads only. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <provider
            android:name="io.github.chalharu.nerust.FaultDocumentsProvider"
            android:authorities="io.github.chalharu.nerust.faultdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="android.permission.MANAGE_DOCUMENTS" />
    </application>
</manifest>
