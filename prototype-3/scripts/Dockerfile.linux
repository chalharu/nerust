ARG RUST_VERSION=1.99.0
FROM rust:${RUST_VERSION}-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libgtk-4-dev libgtk-3-dev libxkbcommon-dev libxkbcommon-x11-dev \
    libx11-dev libxtst-dev libxdo-dev libxcb-shape0-dev libxcb-xfixes0-dev \
    libudev-dev libgl1-mesa-dri xvfb xauth xdotool dbus-x11 \
    fonts-dejavu-core fonts-noto-cjk python3 ca-certificates gdb imagemagick tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy
ENV CARGO_BUILD_JOBS=1 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
WORKDIR /workspace
COPY . .
RUN cargo fetch --locked
CMD ["sh", "scripts/verify.sh"]