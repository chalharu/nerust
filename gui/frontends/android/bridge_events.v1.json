{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nerust Android bridge events v1",
  "x-settings-schema-version": 1,
  "x-saf-chunk-bytes": 65536,
  "description": "Canonical schema for Kotlin→Rust bridge strings sent via MainActivity.onMenuAction. Kotlin builds every string with the BridgeContract builders; the Rust decoder in gui/frontends/android/src/android/menu.rs accepts v1 JSON only. The error-dialog ack travels on the dedicated onErrorDialogDismissed()V native.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/menuEvent" },
    { "$ref": "#/definitions/errorDialogDismissedEvent" }
  ],
  "definitions": {
    "menuEvent": {
      "type": "object",
      "required": ["v", "type", "action"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "menu" },
        "action": {
          "type": "string",
          "enum": [
            "exit",
            "load_state",
            "open_rom",
            "open_settings",
            "orientation_changed",
            "reset",
            "save_state",
            "toggle_pause",
            "unload",
            "controller"
          ]
        },
        "device_id": { "type": "integer" },
        "key": {
          "type": "string",
          "enum": [
            "button1",
            "button2",
            "button5",
            "button6",
            "start",
            "select",
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "pressed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "errorDialogDismissedEvent": {
      "type": "object",
      "required": ["v", "type"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "error_dialog_dismissed" }
      },
      "additionalProperties": false
    }
  },
  "x-menu-action-table": {
    "exit": "MenuAction::Exit",
    "load_state": "MenuAction::LoadState",
    "open_rom": "MenuAction::OpenRom",
    "open_settings": "MenuAction::OpenSettings",
    "orientation_changed": "MenuAction::OrientationChanged",
    "reset": "MenuAction::Reset",
    "save_state": "MenuAction::SaveState",
    "toggle_pause": "MenuAction::TogglePause",
    "unload": "MenuAction::Unload",
    "controller": "MenuAction::ControllerInput{device_id,key,pressed}"
  },
  "x-kotlin-constants": {
    "note": "Kotlin senders MUST use the single-source BridgeContract MenuAction/ControllerKey objects; the Rust decoder in gui/frontends/android/src/bridge_events.rs accepts v1 JSON only. A Rust unit test pins this schema version, action table, and key set.",
    "file": "packaging/android/app/src/main/kotlin/io/github/chalharu/nerust/BridgeWire.kt"
  }
}
