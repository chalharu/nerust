{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nerust Android bridge events v1",
  "description": "Canonical schema for Kotlin→Rust bridge strings sent via MainActivity.onMenuAction. New APKs SHOULD send v1 JSON objects; the Rust decoder in gui/frontends/android/src/android/menu.rs keeps the legacy bare-string IDs for old APKs. A dedicated onErrorDialogDismissed()V native exists for new APKs; the error_dialog_dismissed menu string remains decodable for old APKs.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/menuEvent" },
    { "$ref": "#/definitions/errorDialogDismissedEvent" }
  ],
  "definitions": {
    "menuEvent": {
      "type": "object",
      "required": ["v", "type", "action"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "menu" },
        "action": {
          "type": "string",
          "enum": [
            "exit",
            "load_state",
            "open_rom",
            "open_settings",
            "orientation_changed",
            "reset",
            "save_state",
            "toggle_pause",
            "unload",
            "controller"
          ]
        },
        "device_id": { "type": "integer" },
        "key": {
          "type": "string",
          "enum": [
            "button1",
            "button2",
            "button5",
            "button6",
            "start",
            "select",
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "pressed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "errorDialogDismissedEvent": {
      "type": "object",
      "required": ["v", "type"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "error_dialog_dismissed" }
      },
      "additionalProperties": false
    }
  },
  "x-menu-action-table": {
    "exit": "MenuAction::Exit",
    "load_state": "MenuAction::LoadState",
    "open_rom": "MenuAction::OpenRom",
    "open_settings": "MenuAction::OpenSettings",
    "orientation_changed": "MenuAction::OrientationChanged",
    "reset": "MenuAction::Reset",
    "save_state": "MenuAction::SaveState",
    "toggle_pause": "MenuAction::TogglePause",
    "unload": "MenuAction::Unload",
    "controller": "MenuAction::ControllerInput{device_id,key,pressed}"
  },
  "x-kotlin-constants": {
    "note": "Kotlin senders MUST use the same strings; see ChromeManager.kt DRAWER_ACTIONS / MENU_ACTION_* and MainActivity.sendMenuAction. MENU_ACTION_ERROR_DIALOG_DISMISSED is legacy-only; prefer onErrorDialogDismissed().",
    "file": "packaging/android/app/src/main/kotlin/io/github/chalharu/nerust/ChromeManager.kt"
  }
}
